<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= sharedLink.name %></title>
  <link rel="stylesheet" href="<%= stylesheetUrl %>">
</head>
<body>
  <main class="container sl-menu">
    <div class="sl-brand" aria-label="AudioBoard">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4m4-8v12m4-15v18m4-15v12m4-8v4"/></svg>
      Audio<span>Board</span>
    </div>
    <header class="sl-header">
      <p class="sl-eyebrow">Votre espace audio</p>
      <h1><%= sharedLink.name %></h1>
      <p class="sl-intro">Une playlist à écouter, un enregistrement à partager. Choisissez votre espace.</p>
    </header>
    <% if (destinations.length) { %>
      <div class="sl-toolbar">
        <div class="sl-search">
          <label class="sl-visually-hidden" for="destinationSearch">Rechercher une playlist ou un enregistrement</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
          <input id="destinationSearch" type="search" class="form-control" placeholder="Rechercher une playlist, un enregistrement…" autocomplete="off">
        </div>
        <p class="sl-result-count" id="destinationCount" role="status"><%= destinations.length %> espace<%= destinations.length > 1 ? 's' : '' %></p>
      </div>
      <nav class="sl-grid" aria-label="Playlists et enregistrements">
        <% destinations.forEach(d => { %>
          <% if (d.href) { %>
            <a class="sl-pl-card <%= d.type === 'Enregistrement' ? 'sl-pl-card--record' : '' %>" href="<%= d.href %>" data-search="<%= d.name + ' ' + d.type %>">
              <%- include('partials/shared-link-tile', { destination: d }) %>
            </a>
          <% } else { %>
            <div class="sl-pl-card sl-pl-card--unavailable" data-search="<%= d.name + ' ' + d.type %>">
              <%- include('partials/shared-link-tile', { destination: d }) %>
            </div>
          <% } %>
        <% }) %>
      </nav>
      <div id="destinationEmpty" class="sl-empty" hidden>
        <h2>Aucun résultat</h2>
        <p>Essayez un autre nom ou recherchez « écoute » ou « enregistrement ».</p>
      </div>
    <% } else { %>
      <div class="sl-empty"><h2>À bientôt ici</h2><p>Aucune playlist ni page d’enregistrement disponible pour le moment.</p></div>
    <% } %>
  </main>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(() => {});
      });
    }
    const search = document.getElementById('destinationSearch');
    const normalize = text => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    if (search) search.addEventListener('input', () => {
      let count = 0;
      document.querySelectorAll('[data-search]').forEach(card => {
        card.hidden = !normalize(card.dataset.search).includes(normalize(search.value.trim()));
        if (!card.hidden) count++;
      });
      document.getElementById('destinationCount').textContent = count + ' espace' + (count > 1 ? 's' : '');
      document.getElementById('destinationEmpty').hidden = count > 0;
    });
  </script>
</body>
</html>
