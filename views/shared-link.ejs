<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= sharedLink.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container sl-menu">
    <header class="sl-header"><div>
      <h1><%= sharedLink.name %></h1>
      <p class="text-muted">Choisissez une playlist à écouter ou une page pour vous enregistrer.</p>
    </div></header>
    <% if (destinations.length) { %>
      <label for="destinationSearch">Rechercher une playlist ou un enregistrement</label>
      <input id="destinationSearch" type="search" class="form-control" placeholder="Rechercher par nom ou par type">
      <p class="text-muted text-sm" id="destinationCount" role="status"><%= destinations.length %> lien(s) proposé(s)</p>
      <nav class="sl-grid" aria-label="Playlists et enregistrements">
        <% destinations.forEach(d => { %>
          <% if (d.href) { %>
            <a class="sl-pl-card" href="<%= d.href %>" data-search="<%= d.name + ' ' + d.type %>">
              <span class="sl-pl-card-meta"><%= d.type %></span>
              <span class="sl-pl-card-name"><%= d.name %></span>
              <span class="sl-pl-card-action"><%= d.type === 'Écoute' ? 'Ouvrir la playlist' : 'Ouvrir l’enregistrement' %> →</span>
            </a>
          <% } else { %>
            <div class="sl-pl-card sl-pl-card--unavailable" data-search="<%= d.name + ' ' + d.type %>">
              <span class="sl-pl-card-meta"><%= d.type %></span>
              <span class="sl-pl-card-name"><%= d.name %></span>
              <span class="text-muted text-sm">Lien d’écoute indisponible</span>
            </div>
          <% } %>
        <% }) %>
      </nav>
      <p id="destinationEmpty" class="text-muted" hidden>Aucun lien ne correspond à votre recherche.</p>
    <% } else { %>
      <div class="card"><p class="text-muted">Aucune playlist ni page d’enregistrement disponible pour le moment.</p></div>
    <% } %>
  </main>
  <script>
    const search = document.getElementById('destinationSearch');
    const normalize = text => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    if (search) search.addEventListener('input', () => {
      let count = 0;
      document.querySelectorAll('[data-search]').forEach(card => {
        card.hidden = !normalize(card.dataset.search).includes(normalize(search.value.trim()));
        if (!card.hidden) count++;
      });
      document.getElementById('destinationCount').textContent = count + ' résultat(s)';
      document.getElementById('destinationEmpty').hidden = count > 0;
    });
  </script>
</body>
</html>
